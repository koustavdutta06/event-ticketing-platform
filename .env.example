# Database credentials
CATALOG_DB_URL=jdbc:postgresql://localhost:5433/catalog_db
CATALOG_DB_USERNAME=catalog_user
CATALOG_DB_PASSWORD=catalog_pass

INVENTORY_DB_URL=jdbc:postgresql://localhost:5434/inventory_db
INVENTORY_DB_USERNAME=inventory_user
INVENTORY_DB_PASSWORD=inventory_pass

BOOKING_DB_URL=jdbc:postgresql://localhost:5435/booking_db
BOOKING_DB_USERNAME=booking_user
BOOKING_DB_PASSWORD=booking_pass

AUTH_DB_URL=jdbc:postgresql://localhost:5436/auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_pass

# JWT
JWT_SECRET=<generate: openssl rand -base64 32>
JWT_EXPIRATION_MS=3600000

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<from Razorpay dashboard>
RAZORPAY_WEBHOOK_SECRET=<generate: openssl rand -base64 32>
RAZORPAY_CURRENCY=INR

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Service URLs (for inter-service WebClient calls)
CATALOG_SERVICE_URL=http://localhost:8081
INVENTORY_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8086